{%- comment -%}
  Interactive scent finder: two quick choices score each fragrance block and
  reveal the closest match with its bottle, notes and an add-to-bag button.
{%- endcomment -%}
<section class="finder container" data-finder>
  <div class="finder__intro">
    <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
    <h2 class="display-lg" data-split>{{ section.settings.heading }}</h2>
  </div>

  <div class="finder__body">
    <div class="finder__steps">
      <fieldset class="finder__q">
        <legend><em>01</em> {{ section.settings.q1 }}</legend>
        <div class="chips">
          {%- assign moments = 'dusk,midnight,dawn,noon' | split: ',' -%}
          {%- assign moment_labels = section.settings.q1_options | split: ',' -%}
          {%- for m in moments -%}
            <label class="chip"><input type="radio" name="finder-moment-{{ section.id }}" value="{{ m }}" data-finder-input="moment"><span>{{ moment_labels[forloop.index0] | strip }}</span></label>
          {%- endfor -%}
        </div>
      </fieldset>
      <fieldset class="finder__q">
        <legend><em>02</em> {{ section.settings.q2 }}</legend>
        <div class="chips">
          {%- assign moods = 'warm,mysterious,romantic,radiant' | split: ',' -%}
          {%- assign mood_labels = section.settings.q2_options | split: ',' -%}
          {%- for m in moods -%}
            <label class="chip"><input type="radio" name="finder-mood-{{ section.id }}" value="{{ m }}" data-finder-input="mood"><span>{{ mood_labels[forloop.index0] | strip }}</span></label>
          {%- endfor -%}
        </div>
      </fieldset>
    </div>

    <div class="finder__result" data-finder-result aria-live="polite">
      <div class="finder__placeholder" data-finder-placeholder>
        {% render 'icon-lotus' %}
        <p class="serif-light">{{ section.settings.placeholder }}</p>
      </div>
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        <div class="finder__match" data-finder-match data-moment="{{ block.settings.moment }}" data-mood="{{ block.settings.mood }}" hidden {{ block.shopify_attributes }}>
          <div class="finder__bottle">
            {%- if p.featured_image -%}
              {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: p.title }}
            {%- else -%}
              <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.name }}" loading="lazy" width="600" height="800">
            {%- endif -%}
          </div>
          <div class="finder__info">
            <p class="eyebrow">{{ 'finder.your_match' | t }}</p>
            <h3 class="display-md">{{ p.title | default: block.settings.name }}</h3>
            <p class="muted">{{ block.settings.why }}</p>
            <div class="finder__actions">
              {%- if v -%}
                <button type="button" class="btn btn--gold" data-quick-add="{{ v.id }}"><span>{{ 'product.add_to_cart' | t }} — {{ v.price | money }}</span></button>
              {%- endif -%}
              <a href="{{ p.url | default: routes.all_products_collection_url }}" class="u-link">{{ 'product.view' | t }} →</a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Scent finder",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Scent finder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the fragrance written for you" },
    { "type": "text", "id": "q1", "label": "Question 1", "default": "When do you feel most yourself?" },
    { "type": "text", "id": "q1_options", "label": "Q1 options (dusk, midnight, dawn, noon)", "default": "At dusk, At midnight, At dawn, At high noon" },
    { "type": "text", "id": "q2", "label": "Question 2", "default": "Which word draws you in?" },
    { "type": "text", "id": "q2_options", "label": "Q2 options (warm, mysterious, romantic, radiant)", "default": "Warm, Mysterious, Romantic, Radiant" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Choose two answers to reveal your MIRA." }
  ],
  "blocks": [
    {
      "type": "match",
      "name": "Fragrance match",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "name", "label": "Name (no product)", "default": "Amber Nocturne" },
        { "type": "text", "id": "asset_image", "label": "Fallback theme asset", "default": "bottle-hero.webp" },
        { "type": "select", "id": "moment", "label": "Best moment", "default": "dusk", "options": [ { "value": "dusk", "label": "Dusk" }, { "value": "midnight", "label": "Midnight" }, { "value": "dawn", "label": "Dawn" }, { "value": "noon", "label": "Noon" } ] },
        { "type": "select", "id": "mood", "label": "Best mood", "default": "warm", "options": [ { "value": "warm", "label": "Warm" }, { "value": "mysterious", "label": "Mysterious" }, { "value": "romantic", "label": "Romantic" }, { "value": "radiant", "label": "Radiant" } ] },
        { "type": "textarea", "id": "why", "label": "Why it matches", "default": "Glowing amber and labdanum for golden-hour souls." }
      ]
    }
  ],
  "presets": [{ "name": "Scent finder" }]
}
{% endschema %}
