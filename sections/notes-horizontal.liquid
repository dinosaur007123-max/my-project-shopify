{%- comment -%} Pinned horizontal gallery of raw materials, driven by vertical scroll. {%- endcomment -%}
<section class="notes" id="notes" data-hscroll>
  <div class="notes__pin" data-hscroll-pin>
    <div class="notes__track" data-hscroll-track>
      <div class="notes__intro">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="display-lg" data-split>{{ section.settings.heading }}</h2>
        <p class="muted">{{ section.settings.text }}</p>
        <span class="notes__hint eyebrow">{{ 'general.scroll' | t }} →</span>
      </div>
      {%- for block in section.blocks -%}
        <article class="note-card" data-note {{ block.shopify_attributes }}>
          <span class="note-card__num">0{{ forloop.index }}</span>
          <div class="note-card__media" data-cursor-text="{{ block.settings.title | escape }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title, data-note-img: '' }}
            {%- else -%}
              <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title }}" loading="lazy" width="800" height="1000" data-note-img>
            {%- endif -%}
          </div>
          <div class="note-card__body">
            <p class="eyebrow">{{ block.settings.origin }}</p>
            <h3 class="display-md">{{ block.settings.title }}</h3>
            <p class="muted">{{ block.settings.text }}</p>
          </div>
        </article>
      {%- endfor -%}
      <div class="notes__end" aria-hidden="true">{% render 'icon-lotus' %}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients (horizontal)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Raw materials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four treasures of the Orient" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Each note is sourced from a single origin and blended in small batches of two hundred flacons." }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset_image", "label": "Fallback theme asset", "default": "note-oud.webp" },
        { "type": "text", "id": "origin", "label": "Origin", "default": "Assam · India" },
        { "type": "text", "id": "title", "label": "Title", "default": "Agarwood Oud" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Liquid gold of the East — resinous, smoky and impossibly deep." }
      ]
    }
  ],
  "presets": [{ "name": "Ingredients (horizontal)" }]
}
{% endschema %}
