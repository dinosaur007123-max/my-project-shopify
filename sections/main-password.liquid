<section class="password">
  <div class="password__lotus" aria-hidden="true"><img src="{{ 'lotus.webp' | asset_url }}" alt="" width="1400" height="1400"></div>
  <img class="password__bottle" src="{{ 'bottle-hero.webp' | asset_url }}" alt="" width="600" height="900">
  <div class="password__inner">
    {% render 'icon-lotus' %}
    <h1 class="password__word">{{ shop.name | upcase }}</h1>
    <p class="serif-light password__msg">{{ shop.password_message | default: section.settings.message }}</p>
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p>{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <input type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" required aria-label="{{ 'newsletter.label' | t }}">
        <button type="submit" class="btn btn--gold"><span>{{ 'password.notify' | t }}</span></button>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary class="u-link small">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter-form' -%}
        <input type="password" name="password" placeholder="{{ 'password.password' | t }}" aria-label="{{ 'password.password' | t }}">
        <button type="submit" class="btn btn--ghost"><span>{{ 'password.enter' | t }}</span></button>
        {%- if form.errors -%}<p class="newsletter-form__error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [ { "type": "text", "id": "message", "label": "Message", "default": "A new maison of Arabian perfume is about to open its doors." } ]
}
{% endschema %}
