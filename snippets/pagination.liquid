<nav class="pagination" aria-label="Pagination">
  {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="arrow-btn" aria-label="{{ 'general.previous' | t }}">‹</a>{%- endif -%}
  {%- for part in paginate.parts -%}
    {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span{% if part.title == paginate.current_page %} aria-current="page" class="is-current"{% endif %}>{{ part.title }}</span>{%- endif -%}
  {%- endfor -%}
  {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="arrow-btn" aria-label="{{ 'general.next' | t }}">›</a>{%- endif -%}
</nav>
