<div class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__backdrop" data-cart-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
    <header class="cart-drawer__head">
      <h2 class="display-sm">{{ 'cart.title' | t }} <sup data-cart-count>{{ cart.item_count }}</sup></h2>
      <button type="button" class="icon-btn" data-cart-close aria-label="{{ 'general.close' | t }}">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
    </header>
    <div class="cart-drawer__body" data-cart-items>
      {% render 'cart-items', cart: cart %}
    </div>
    <footer class="cart-drawer__foot">
      <div class="cart-drawer__total">
        <span>{{ 'cart.subtotal' | t }}</span>
        <strong data-cart-total>{{ cart.total_price | money }}</strong>
      </div>
      <p class="muted small">{{ 'cart.taxes' | t }}</p>
      <a href="{{ routes.cart_url }}" class="btn btn--ghost btn--block">{{ 'cart.view' | t }}</a>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="btn btn--gold btn--block"><span>{{ 'cart.checkout' | t }}</span></button>
      </form>
    </footer>
  </aside>
</div>
