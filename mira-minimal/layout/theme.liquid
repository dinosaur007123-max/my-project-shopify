<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title }}{% if current_tab > 1 %} – Page {{ current_tab }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" href="{{ 'mira-logo.png' | asset_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:image" content="{{ 'hero.webp' | asset_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-{{ request.page_type | handleize }}">
    <a class="skip" href="#main">Skip to content</a>
    {% sections 'header-group' %}
    <main id="main">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
  </body>
</html>
