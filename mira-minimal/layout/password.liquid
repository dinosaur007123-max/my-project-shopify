<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main class="password">
      <img class="password__logo" src="{{ 'mira-logo.png' | asset_url }}" alt="{{ shop.name }}">
      <p>{{ shop.password_message | default: 'Opening soon.' }}</p>
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <div class="password__row">
          <input type="password" name="password" placeholder="Enter password" aria-label="Password">
          <button class="btn" type="submit">Enter</button>
        </div>
      {% endform %}
    </main>
    {{ content_for_layout }}
  </body>
</html>
