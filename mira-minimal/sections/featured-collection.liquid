{%- assign col = section.settings.collection | default: collections.all -%}
<section class="block">
  <header class="block__head">
    <h2>{{ section.settings.heading }}</h2>
    <a href="{{ col.url }}">View all</a>
  </header>
  <div class="grid">
    {%- for product in col.products limit: section.settings.limit -%}
      {% render 'product-card', product: product %}
    {%- else -%}
      <p class="muted">Add products to this collection to see them here.</p>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Collection" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
